# CareOne Backend Environment Configuration
# Copy this file to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
#
# This ONE file is read by both the `postgres` and the `api` container
# (docker-compose.yml points env_file at it for both).

# ============================================================
# Server
# ============================================================
PORT=5000

# Public origin(s) of the site, comma-separated, no trailing slash.
# Only used for CORS. In the Docker/VPS setup the client is served from the
# same origin as the API, so this rarely matters — but keep it accurate.
CLIENT_ORIGIN=https://careone.example.com,https://www.careone.example.com

# ============================================================
# PostgreSQL container
# ============================================================
# These initialise the database on the volume's FIRST run and are also the
# source docker-entrypoint.sh builds DATABASE_URL from.
# Generate the password with: openssl rand -base64 24
POSTGRES_USER=careone
POSTGRES_PASSWORD=
POSTGRES_DB=careone

# ============================================================
# Database URL
# ============================================================
# Deliberately NOT set here. server/docker-entrypoint.sh derives it from the
# three POSTGRES_* values above and forces the host to `postgres`, so a local
# 127.0.0.1:5434 value can never leak into the container.
#
# Set it ONLY when using an external database, and unset the POSTGRES_* vars:
# DATABASE_URL=postgresql://user:pass@host:5432/careone?schema=public

# ============================================================
# JWT
# ============================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ============================================================
# Admin seed
# ============================================================
# prisma/seed.js runs on every container start. It creates this admin if it is
# missing, and re-syncs the password if this value changed. It EXITS 1 when
# ADMIN_SEED_PASSWORD is empty, which fails the deploy on purpose.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# ============================================================
# Cloudinary — gallery image storage
# ============================================================
# Uploads are streamed straight to Cloudinary (no local disk, no volume).
# If these are blank the upload endpoint returns 503 instead of failing oddly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# Google Places — live reviews
# ============================================================
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
