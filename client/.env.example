# The API base URL the client is compiled against.
#
# Production (Docker/VPS): the API is served from the SAME origin as the site,
# proxied by nginx at /api — so a relative path is all that is needed and there
# is no CORS involved.
VITE_API_URL=/api

# Local development (server running on your machine, client on Vite's dev port):
# VITE_API_URL=http://localhost:5000/api
